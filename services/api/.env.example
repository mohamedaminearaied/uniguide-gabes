# Easiest way to fill this file: run  npm run configure  from the project root.
# PRIVATE: never commit this file, never paste it in chat or a screenshot.
PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres.YOUR-REF:YOUR-PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_JWKS_URL=https://YOUR-REF.supabase.co/auth/v1/.well-known/jwks.json
# Optional (emails). API key from Brevo, starts with xkeysib-
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=UniGuide Gabès
